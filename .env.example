# Servidor (apps/server)
PORT=2567
CORS_ORIGIN=*
MAX_PLAYERS=50

# Persistencia (Etapa 12). Escolha UMA; sem nenhuma, usa arquivos em DATA_DIR (local).
# PostgreSQL (recomendado): cria as tabelas sozinho. Remoto exige SSL (automatico); DATABASE_SSL=disable | verify.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DATABASE_SSL=
# Quantas copias de historico (snapshots) guardar por registro (1-500)
# SNAPSHOT_KEEP=20
# DATA_DIR=data

# Cliente web (apps/web) - lido pelo Vite
VITE_SERVER_URL=http://localhost:2567
