# Servidor (apps/server)
PORT=2567
CORS_ORIGIN=*
MAX_PLAYERS=50   # por mundo, de 1 a 50 (nunca passa de 50)
# Mundos (Etapa 13): id:Nome:regiao separados por ; (id so com a-z, 0-9 e hifen). Padrao: um mundo "mundo-1".
# WORLDS=mundo-1:Mundo 1:br;mundo-2:Mundo 2:br

# Persistencia (Etapa 12). Escolha UMA; sem nenhuma, usa arquivos em DATA_DIR (local).
# PostgreSQL (recomendado): cria as tabelas sozinho. Remoto exige SSL (automatico); DATABASE_SSL=disable | verify.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DATABASE_SSL=
# Quantas copias de historico (snapshots) guardar por registro (1-500)
# SNAPSHOT_KEEP=20
# DATA_DIR=data

# Cliente web (apps/web) - lido pelo Vite
VITE_SERVER_URL=http://localhost:2567

# Etapa 14 - temporada de 7 dias (padrao). SO PARA TESTE: encurtar a temporada (minimo 5 s) e o aviso final.
# SEASON_LENGTH_SECONDS=604800
# SEASON_GRACE_SECONDS=30
