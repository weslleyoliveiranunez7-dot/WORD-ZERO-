{
  "name": "world-zero",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev:web": "pnpm --filter @worldzero/web dev",
    "dev:server": "pnpm --filter @worldzero/server dev",
